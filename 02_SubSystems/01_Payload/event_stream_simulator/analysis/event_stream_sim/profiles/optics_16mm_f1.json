    "mosaic.rows":          {"value": 3, "unit": "heads along-track", "uncertainty": "-", "source": "coverage.py", "status": "convention"},
    "mosaic.overlap":       {"value": 0.05, "unit": "-", "uncertainty": "-", "source": "coverage.py", "status": "convention"}
