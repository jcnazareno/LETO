   "value": 4.86,
   "status": "datasheet",
   "note": "Sony IMX636 flyer"
  },
  "e_per_pair_eV": {
   "value": 3.6,
   "range": [
    3.6,
    3.65
   ],
   "status": "published",
   "note": "silicon, room temperature"
  },
  "straggling_sigma_ln": {
   "value": 0.5,
   "range": [
    0.3,
    0.8
   ],
   "status": "assumed",
   "note": "energy-loss straggling in a few-um layer is much wider than in CRaTER's 1 mm; lognormal stand-in"
  },
  "angular_distribution": {
   "value": "isotropic, cos-weighted on the sensor plane",
   "status": "assumed",
   "note": "omnidirectional GCR; spacecraft shielding treated as isotropic"
  },
  "shielding": {
   "value": "as CRaTER D2 (0.81 mm Al end cap plus LRO structure)",
   "status": "assumed",
   "note": "GCR above ~100 MeV dominates; the spectrum is not transported through the camera housing"
  },
  "diffusion": {
   "value": "none (charge stays in the crossed pixel columns)",
   "status": "assumed"
  },
  "albedo_particles": {
   "value": "included in the singles rate at LRO altitude, not rescaled",
   "status": "assumed",
   "note": "lunar albedo protons and secondaries are a few percent; scaling them as GCR slightly overstates them at 3000 km"
  },
  "telescope_geometry": {
   "value": "D2&D4&D6 coincidence treated as D1.D6 (G = 0.569 cm^2 sr)",
   "status": "derived",
   "note": "thin-detector flags are set on every event and cannot define D1 coincidences"
  },
  "nuclear_interactions": {
   "value": "LET tail above ~2 keV/um includes interaction products in 1 mm Si",
   "status": "assumed",
