% GMAT R2026a: Option A srp_high_high
% Generated by analysis/gmat_lunar_setup/setup_mission.py.
% Study assumptions; not a selected flight trajectory or a lifetime/coverage demonstration.
% Start: already captured in lunar orbit; launch, cruise, capture and commissioning are excluded.
% Initial plane is exactly polar to DE421 PA at epoch; subsequent plane drift is propagated.
% GRGM900C + DE421 PA are frame-matched. Do not replace with DE430 coefficients silently.
% Stationkeeping, if enabled, is ideal circularization at the CURRENT radius, not altitude/node control.

SolarSystem.EphemerisSource = DE421;
Luna.Mu = 4902.79996708864019;
Luna.EquatorialRadius = 1738.0;
Luna.Flattening = 0;
Luna.RotationDataSource = SPICE;
Luna.SpiceFrameId = 'MOON_PA_DE421';

Create CoordinateSystem LunaICRF;
LunaICRF.Origin = Luna;
LunaICRF.Axes = ICRF;
Create CoordinateSystem LunarEquatorJ2000;
LunarEquatorJ2000.Origin = Luna;
LunarEquatorJ2000.Axes = BodyInertial;

Create ChemicalTank Fuel;
Fuel.FuelMass = 35.254007987668;
Create Spacecraft SMD;
SMD.CoordinateSystem = LunaICRF;
SMD.DateFormat = UTCGregorian;
SMD.Epoch = '01 Jan 2031 00:00:00.000';
SMD.DisplayStateType = Cartesian;
SMD.X = -4694.557235857528;
SMD.Y = -621.0616557124655;
SMD.Z = -155.1089264401413;
SMD.VX = 0.0242764459310794;
SMD.VY = -0.4153377441420759;
SMD.VZ = 0.9282714119336669;
SMD.DryMass = 118.1;
SMD.Tanks = {Fuel};
SMD.Cr = 1.8;
SMD.SRPArea = 2.0;
SMD.DragArea = 0;
% Kinematic pointing law only; no closed-loop attitude dynamics or sensor jitter.
SMD.Attitude = NadirPointing;
SMD.AttitudeReferenceBody = Luna;
SMD.AttitudeConstraintType = OrbitNormal;
SMD.BodyAlignmentVectorX = 0;
SMD.BodyAlignmentVectorY = 0;
SMD.BodyAlignmentVectorZ = 1;
SMD.BodyConstraintVectorX = 0;
SMD.BodyConstraintVectorY = 1;
SMD.BodyConstraintVectorZ = 0;

Create ForceModel LunarEnvironment;
LunarEnvironment.CentralBody = Luna;
LunarEnvironment.PrimaryBodies = {Luna};
LunarEnvironment.PointMasses = {Earth, Sun, Jupiter, Venus, Mars, Saturn};
LunarEnvironment.Drag = None;
LunarEnvironment.SRP = On;
LunarEnvironment.RelativisticCorrection = On;
LunarEnvironment.ErrorControl = RSSStep;
LunarEnvironment.GravityField.Luna.Degree = 80;
LunarEnvironment.GravityField.Luna.Order = 80;
LunarEnvironment.GravityField.Luna.PotentialFile = 'C:\Users\marin\OneDrive\Dokumente\gmat-win-R2022a\GMAT\data\gravity\luna\grgm900c.cof';
LunarEnvironment.GravityField.Luna.TideFile = 'C:\Users\marin\OneDrive\Dokumente\gmat-win-R2022a\GMAT\data\gravity\luna\grgm900c.tide';
LunarEnvironment.GravityField.Luna.TideModel = 'Solid';
LunarEnvironment.SRP.SRPModel = Spherical;
LunarEnvironment.SRP.Flux = 1361;
LunarEnvironment.SRP.Nominal_Sun = 149597870.7;
% GMAT uses its built-in conical shadow model; ShadowModel is not script-settable.
%LunarEnvironment.SRP.ExtraShadowBodies = {Earth};

Create Propagator LunarProp;
LunarProp.FM = LunarEnvironment;
LunarProp.Type = PrinceDormand78;
LunarProp.InitialStepSize = 10;
LunarProp.Accuracy = 1e-11;
LunarProp.MinStep = 0.001;
LunarProp.MaxStep = 60.0;
LunarProp.MaxStepAttempts = 100;
LunarProp.StopIfAccuracyIsViolated = true;

Create DifferentialCorrector LoweringDC;
LoweringDC.MaximumIterations = 40;
LoweringDC.ShowProgress = true;
LoweringDC.ReportFile = 'C:\Users\marin\OneDrive\Desktop\SMD\srp_high_high_targeter.txt';

Create ImpulsiveBurn Lower1;
Lower1.CoordinateSystem = Local;
Lower1.Origin = Luna;
Lower1.Axes = VNB;
Lower1.Element1 = 0;
Lower1.Element2 = 0;
Lower1.Element3 = 0;
Lower1.DecrementMass = true;
Lower1.Tank = {Fuel};
Lower1.Isp = 300.0;
Lower1.GravitationalAccel = 9.80665;

Create ImpulsiveBurn Lower2;
Lower2.CoordinateSystem = Local;
Lower2.Origin = Luna;
Lower2.Axes = VNB;
Lower2.Element1 = 0;
Lower2.Element2 = 0;
Lower2.Element3 = 0;
Lower2.DecrementMass = true;
Lower2.Tank = {Fuel};
Lower2.Isp = 300.0;
Lower2.GravitationalAccel = 9.80665;

Create ImpulsiveBurn Maintenance;
Maintenance.CoordinateSystem = Local;
Maintenance.Origin = Luna;
Maintenance.Axes = VNB;
Maintenance.Element1 = 0;
Maintenance.Element2 = 0;
Maintenance.Element3 = 0;
Maintenance.DecrementMass = true;
Maintenance.Tank = {Fuel};
Maintenance.Isp = 300.0;
Maintenance.GravitationalAccel = 9.80665;

Create ReportFile History Burns;
History.Filename = 'C:\Users\marin\OneDrive\Desktop\SMD\srp_high_high_history.txt';
History.Precision = 16;
Burns.Filename = 'C:\Users\marin\OneDrive\Desktop\SMD\srp_high_high_burns.txt';
Burns.Precision = 16;
Create OrbitView LunarView;
LunarView.Add = {SMD, Luna};
LunarView.CoordinateSystem = LunaICRF;
LunarView.ViewPointReference = Luna;
LunarView.ViewPointVector = [18000 0 8000];
LunarView.ViewDirection = Luna;
LunarView.ShowPlot = true;
Create Variable Phase DVtotal DVmaintenance DVlowering BurnDV Hperi Hapo Hrad;
Create Variable NextEpoch NextCheck EndPhase LoopEnd Vr Vt Vmag Vcirc; 
BeginMissionSequence;
Phase = 1;
DVtotal = 0;
DVmaintenance = 0;
DVlowering = 0;
Hperi = SMD.Luna.RadPer - 1738.0;
Hapo = SMD.Luna.RadApo - 1738.0;
Hrad = SMD.Luna.RMAG - 1738.0;
Report History SMD.ElapsedDays Phase SMD.LunaICRF.X SMD.LunaICRF.Y SMD.LunaICRF.Z SMD.LunaICRF.VX SMD.LunaICRF.VY SMD.LunaICRF.VZ SMD.Luna.SMA SMD.Luna.ECC SMD.LunarEquatorJ2000.INC Hrad Hperi Hapo SMD.TotalMass SMD.Fuel.FuelMass DVtotal DVmaintenance DVlowering;
EndPhase = SMD.A1ModJulian + 7;
LoopEnd = EndPhase - 0.00000001;
NextCheck = SMD.A1ModJulian + 1.0;
While SMD.A1ModJulian < LoopEnd
NextEpoch = SMD.A1ModJulian + 0.04166666666666666;
If NextEpoch > EndPhase
NextEpoch = EndPhase;
EndIf;
Propagate LunarProp(SMD) {SMD.A1ModJulian = NextEpoch, SMD.Luna.RMAG = 1758.0};
If SMD.Luna.RMAG < 1758.01
Hperi = SMD.Luna.RadPer - 1738.0;
Hapo = SMD.Luna.RadApo - 1738.0;
Hrad = SMD.Luna.RMAG - 1738.0;
Report History SMD.ElapsedDays Phase SMD.LunaICRF.X SMD.LunaICRF.Y SMD.LunaICRF.Z SMD.LunaICRF.VX SMD.LunaICRF.VY SMD.LunaICRF.VZ SMD.Luna.SMA SMD.Luna.ECC SMD.LunarEquatorJ2000.INC Hrad Hperi Hapo SMD.TotalMass SMD.Fuel.FuelMass DVtotal DVmaintenance DVlowering;
Stop;
EndIf;
Hperi = SMD.Luna.RadPer - 1738.0;
Hapo = SMD.Luna.RadApo - 1738.0;
Hrad = SMD.Luna.RMAG - 1738.0;
Report History SMD.ElapsedDays Phase SMD.LunaICRF.X SMD.LunaICRF.Y SMD.LunaICRF.Z SMD.LunaICRF.VX SMD.LunaICRF.VY SMD.LunaICRF.VZ SMD.Luna.SMA SMD.Luna.ECC SMD.LunarEquatorJ2000.INC Hrad Hperi Hapo SMD.TotalMass SMD.Fuel.FuelMass DVtotal DVmaintenance DVlowering;
EndWhile;
% DV values are actual ideal impulses, not integrated acceleration norms.
Hperi = SMD.Luna.RadPer - 1738.0;
Hapo = SMD.Luna.RadApo - 1738.0;
Hrad = SMD.Luna.RMAG - 1738.0;
Report History SMD.ElapsedDays Phase SMD.LunaICRF.X SMD.LunaICRF.Y SMD.LunaICRF.Z SMD.LunaICRF.VX SMD.LunaICRF.VY SMD.LunaICRF.VZ SMD.Luna.SMA SMD.Luna.ECC SMD.LunarEquatorJ2000.INC Hrad Hperi Hapo SMD.TotalMass SMD.Fuel.FuelMass DVtotal DVmaintenance DVlowering;
